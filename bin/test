#!/usr/bin/env bash
set -euo pipefail

selfdir="$(dirname "$(readlink -f "$0")")"
testsdir="$selfdir/../tests"

run_test() {
  local name="$1"

  echo -e "\n--- $name ---\n"
  nvim --headless -u NONE -c "set rtp+=." \
    -c "luafile $testsdir/${name}_test.lua" \
    -c "q"
}

run_test 'lib/fifo'

run_test 'pattern_legacy/classify_char_class_wordness'
run_test 'pattern_legacy/pattern_legacy'

run_test 'args/parser'
run_test 'args/unquoter'
run_test 'args/tokeniser'

run_test 'pattern/tokeniser_01_basic'
run_test 'pattern/tokeniser_02_groups'
run_test 'pattern/tokeniser_03_escapes'
run_test 'pattern/tokeniser_04_charclass'
run_test 'pattern/tokeniser_05_complex'

run_test 'pattern/parser_01_escape'
run_test 'pattern/parser_02_wordness'
run_test 'pattern/parser_03_boundary'
run_test 'pattern/parser_04_validation'
run_test 'pattern/parser_05_complex'

run_test 'pattern/translator_01_basics'
run_test 'pattern/translator_02_literals'
run_test 'pattern/translator_03_escapes'
run_test 'pattern/translator_04_boundary'
run_test 'pattern/translator_05_quantifiers'
run_test 'pattern/translator_06_groups'
run_test 'pattern/translator_07_charclass'
run_test 'pattern/translator_08_complex'
