#!/usr/bin/env bash
set -euo pipefail

selfdir="$(dirname "$(readlink -f "$0")")"
testsdir="$selfdir/../tests"

run_test() {
  local name="$1"

  echo -e "\n--- $name ---\n"
  nvim --headless \
    -c "luafile $testsdir/${name}_test.lua" \
    -c "q"
}

run_test fifo
run_test classify_char_class_wordness
run_test pattern_legacy
run_test 'args/parser'
run_test 'args/unquoter'
run_test 'args/tokeniser'
run_test 'pattern/tokeniser'
run_test 'pattern/parser'
run_test 'pattern/translator'
