#!/usr/bin/env bash
set -euo pipefail

selfdir="$(dirname "$(readlink -f "$0")")"
testsdir="$selfdir/../tests"

run_test() {
  local name="$1"

  echo -e "\n--- $name ---\n"
  nvim --headless -u NONE -c "set rtp+=." \
    -c "luafile $testsdir/${name}_test.lua" \
    -c "q"
}

run_test 'lib/fifo'
run_test 'pattern_legacy/classify_char_class_wordness'
run_test 'pattern_legacy/pattern_legacy'
run_test 'args/parser'
run_test 'args/unquoter'
run_test 'args/tokeniser'
run_test 'pattern/translator'
run_test 'pattern/tokeniser_basic'
run_test 'pattern/tokeniser_groups'
run_test 'pattern/tokeniser_escapes'
run_test 'pattern/tokeniser_charclass'
run_test 'pattern/tokeniser_complex'
run_test 'pattern/parser_boundary'
run_test 'pattern/parser_wordness'
run_test 'pattern/parser_escape'
run_test 'pattern/parser_validation'
run_test 'pattern/parser_complex'
