#!/usr/bin/env bash
set -euo pipefail

selfdir="$(dirname "$(readlink -f "$0")")"
rootdir=$(cd "$selfdir"; git rev-parse --show-toplevel)

# NOTE: --no-config keeps the user's ripgrep config file out of the output
# (e.g. --trim would strip the indentation from the replacement strings).

# Lists all the ripgrep named arguments (flags and options) listed by the
# ripgrep help command, one per line.
#
# It assumes that they are always indented exactly by 4 spaces.
all=$(
  rg --help \
    | rg --no-config --no-line-number --color=never --only-matching '^\s{4}(-.+$)' --replace '$1' \
    | sed 's/, /\n/g'
)

# NOTE: Ensure traditional byte-order sorting by setting LC_ALL=C

flags=$(
  echo "$all" \
    | rg --no-config --no-line-number --color=never '^([^ =]+)$' --replace "  ['\$1'] = true," \
    | LC_ALL=C sort
)

options=$(
  echo "$all" \
    | rg --no-config --no-line-number --color=never '^(.+?)[ =].+' --replace "  ['\$1'] = true," \
    | LC_ALL=C sort
)

# Generate Lua code containing a set of ripgrep options (named arguments that
# take a value).
cat <<EOF | tee "$rootdir/lua/brook/lib/rg_named_args.lua"
-- GENERATED FILE: see ../../../bin/generate-rg-named-args

--- List of ripgrep named arguments. Used for search pattern selection.
local M = {}

--- Set of ripgrep's named arguments that act like switches, don't take a value.
M.flags = {
${flags}
}

--- Set of ripgrep's named arguments that require a value.
M.options = {
${options}
}

return M
EOF
